<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Genocs.BarcodeLibrary.WebApi</PackageId>
        <RootNamespace>Genocs.BarcodeLibrary.WebApi</RootNamespace>
        <AssemblyName>Genocs.BarcodeLibrary.WebApi</AssemblyName>
        <Title>The BarcodeLibrary webapi service.</Title>
        <Description>The BarcodeLibrary webapi service.</Description>
        <UserSecretsId>Genocs</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>

        <IsPackable>false</IsPackable>
        <!-- Disable web.config transformation for Docker builds -->
        <TransformWebConfigEnabled>false</TransformWebConfigEnabled>
        <WebConfigTransformEnabled>false</WebConfigTransformEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Genocs.Core" Version="9.0.1" />
        <PackageReference Include="Genocs.Logging" Version="9.0.1" />
        <PackageReference Include="Genocs.Persistence.MongoDB" Version="9.0.1" />
        <PackageReference Include="Genocs.WebApi" Version="9.0.1" />
        <PackageReference Include="Genocs.WebApi.OpenApi" Version="9.0.1" />

        <PackageReference Include="FluentResults" Version="4.0.0" />
        <PackageReference Include="MediatR" Version="14.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Genocs.BarcodeLibrary\Genocs.BarcodeLibrary.csproj" />
        <ProjectReference Include="..\Genocs.QRCodeLibrary\Genocs.QRCodeLibrary.csproj" />
    </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Genocs.BarcodeLibrary</PackageId>
        <RootNamespace>Genocs.BarcodeLibrary</RootNamespace>
        <AssemblyName>Genocs.BarcodeLibrary</AssemblyName>
        <Title>Library to build Barcodes for .NET Core projects.</Title>
        <Description>QRCode library for .NET Core.</Description>
        <LangVersion>10.0</LangVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>5.0.0</Version>
        <MinClientVersion>5.0.0</MinClientVersion>
        <Authors>Nocco Giovanni Emanuele</Authors>
        <Company>Genocs</Company>
        <Copyright>Genocs 2026</Copyright>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/Genocs/qrcode.git</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Genocs/qrcode.git</RepositoryUrl>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryType>git</RepositoryType>
        <PackageTags>barcode reader writer</PackageTags>
        <PackageReleaseNotes>Removed reference</PackageReleaseNotes>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>


    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\..\icon.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.151.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
        <PackageReference Include="System.Text.Json" Version="10.0.10" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <PackageId>Genocs.QRCodeLibrary</PackageId>
        <RootNamespace>Genocs.QRCodeLibrary</RootNamespace>
        <AssemblyName>Genocs.QRCodeLibrary</AssemblyName>
        <Title>Library to build QRCode for .NET</Title>
        <Description>QRCode library for .NET</Description>
        <PackageTags>QRCode reader writer</PackageTags>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.153.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Genocs.QRCodeLibrary.UnitTests" />
    </ItemGroup>
</Project>

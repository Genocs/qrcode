<?xml version="1.0" encoding="UTF-8"?>
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
	<fo:layout-master-set>
		<fo:simple-page-master master-name="A4" page-width="210mm" page-height="297mm" margin="5mm">
			<fo:region-body/>
		</fo:simple-page-master>
	</fo:layout-master-set>
	<fo:page-sequence master-reference="A4">
		<fo:flow flow-name="xsl-region-body">
			<fo:block font-family="Nunito" font-size="24pt" font-weight="bold" space-after="10mm">
				Nunito Font Sample
			</fo:block>
			<fo:block font-family="Nunito" font-size="12pt" space-after="5mm">
				This paragraph uses Nunito Regular at 12pt. The quick brown fox jumps over the lazy dog.
			</fo:block>
			<fo:block font-family="Nunito" font-size="12pt" font-weight="bold" space-after="5mm">
				This paragraph uses Nunito Bold at 12pt. The quick brown fox jumps over the lazy dog.
			</fo:block>
			<fo:block font-family="Nunito" font-size="12pt" font-style="italic" space-after="5mm">
				This paragraph uses Nunito Italic at 12pt. The quick brown fox jumps over the lazy dog.
			</fo:block>
			<fo:block font-family="Nunito" font-size="16pt" color="#0066CC" space-after="5mm">
				Colored text in Nunito 16pt.
			</fo:block>
			<fo:block font-family="Nunito" font-size="10pt" color="#666666">
				Accented characters: àèìòù éüñç — 0123456789
			</fo:block>
		</fo:flow>
	</fo:page-sequence>
</fo:root>
